# Ustawienia uzytkownika w systemie hosta (np. OpenMediaVault)
# Sprawdz id na hoście poleceniem: id <twoj_uzytkownik>
PUID=1000
PGID=100

# Strefa czasowa
TZ=Europe/Warsaw

# Nazwa urzadzenia widoczna w przegladarce (antigravity.google.com)
INSTANCE_NAME=OMV-Antigravity

# Czy uruchamiac Remote Control w tle (true/false)
AUTO_START_REMOTE=true

# Wbudowany Web Terminal (port 7681)
ENABLE_WEB_TERMINAL=true
WEB_TERMINAL_PORT=7681

# Opcjonalne zabezpieczenie Web Terminala (zakomentuj, jesli uzywasz tylko w sieci lokalnej LAN)
# WEB_TERMINAL_USER=admin
# WEB_TERMINAL_PASS=sekretne_haslo

# Sciezki do danych na Twoim serwerze OMV (dla uzycia zmiennych w Compose)
CONFIG_DIR=./config
WORKSPACE_DIR=./workspace
